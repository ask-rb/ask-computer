#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo "==> Installing dependencies..."
bundle install

echo "==> Checking Cua Driver..."
if command -v cua-driver >/dev/null 2>&1; then
  echo "  cua-driver found: $(cua-driver --version 2>&1 | head -n 1)"
  cua-driver history status 2>&1 | sed 's/^/  /' || true
else
  echo "  cua-driver not installed."
  echo "  Run: bundle exec ask-computer install          # stable"
  echo "  Or:  bundle exec ask-computer setup --channel nightly --with-history"
  echo "  (dry run: add --dry-run to preview the command)"
fi

echo "==> Setup complete! Run 'bundle exec rake test' to verify."
